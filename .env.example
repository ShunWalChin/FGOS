# Core-Engine local environment
# Copy to .env and replace every dev-* secret before production.

ENVIRONMENT=development
APP_NAME=core-engine
API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_USER=core
POSTGRES_PASSWORD=dev-postgres-password
POSTGRES_DB=saas_core
DATABASE_URL=postgresql+asyncpg://core:dev-postgres-password@postgres:5432/saas_core

REDIS_PASSWORD=dev-redis-password
REDIS_URL=redis://:dev-redis-password@redis:6379/0

CLICKHOUSE_PASSWORD=dev-clickhouse-password
CLICKHOUSE_DSN=http://bi:dev-clickhouse-password@clickhouse:8123/default

N8N_ENCRYPTION_KEY=replace-with-64-hex-chars
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/

META_APP_SECRET=replace-with-meta-app-secret
META_VERIFY_TOKEN=replace-with-meta-verify-token

# Module B — Social/Ads
# Token-at-rest encryption (pgcrypto). Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=dev-token-encryption-key-change-me
# Keep false in dev: providers run dry-run (no real network calls).
SOCIAL_LIVE=false
OAUTH_REDIRECT_BASE=http://localhost:8000
META_CLIENT_ID=
META_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Development fallback until webhook account-to-agency resolution is implemented.
DEFAULT_AGENCY_ID=00000000-0000-0000-0000-000000000001

STREAM_EVENTS=stream:events
STREAM_WEBHOOKS_META=stream:webhooks.meta
STREAM_BI=stream:bi.events
WORKER_GROUP=core-engine
MAX_EVENT_HOPS=5
MESSAGING_DEBOUNCE_SECONDS=2
SOCIAL_WORKER_POLL_SECONDS=1
SOCIAL_MAX_ATTEMPTS=5
SOCIAL_RATE_LIMIT_COOLDOWN_SECONDS=900
BI_BATCH_SIZE=500
BI_FLUSH_SECONDS=5
